/* Heavy Metal Agent TUI - Dark Crypto Terminal Stylesheet */

Screen {
    background: #14161a;
    color: #f1f3f5;
}

/* Header HUD */
#header-hud {
    dock: top;
    height: 3;
    background: #181b21;
    border-bottom: solid #2e3440;
    padding: 0 1;
}

.hud-brand {
    text-style: bold;
    color: #9945ff;
}

.hud-cluster-mainnet {
    background: #14f195;
    color: #14161a;
    text-style: bold;
    padding: 0 1;
}

.hud-cluster-devnet {
    background: #f5a623;
    color: #14161a;
    text-style: bold;
    padding: 0 1;
}

.hud-wallet {
    color: #c9ccd1;
}

.hud-balance {
    color: #14f195;
    text-style: bold;
}

.hud-node {
    color: #7e8590;
}

/* Main Layout */
#main-container {
    height: 1fr;
    width: 100%;
}

/* Chat & Stream Area */
#chat-container {
    width: 70%;
    height: 100%;
}

#chat-scroll {
    height: 100%;
    scrollbar-color: #9945ff #1e2229;
    padding: 1 1;
}

/* Chat Bubbles */
.chat-bubble-user {
    background: #1e222b;
    border-left: thick #9945ff;
    padding: 1 1;
    margin-bottom: 1;
    height: auto;
}

.chat-bubble-agent {
    background: #181c22;
    border-left: thick #14f195;
    padding: 1 1;
    margin-bottom: 1;
    height: auto;
}

.chat-sender-user {
    color: #9945ff;
    text-style: bold;
    margin-bottom: 0;
}

.chat-sender-agent {
    color: #14f195;
    text-style: bold;
    margin-bottom: 0;
}

.chat-thinking {
    color: #7e8590;
    text-style: italic;
    margin-bottom: 1;
    padding-left: 2;
}

/* Token Radar Card */
.radar-card {
    background: #1c2027;
    border: solid #9945ff;
    padding: 1 2;
    margin: 1 0;
    height: auto;
}

.radar-header {
    text-style: bold;
    color: #14f195;
    margin-bottom: 1;
}

.radar-metrics {
    color: #f1f3f5;
    margin-bottom: 1;
}

.radar-bar {
    margin-bottom: 1;
}

.radar-safety {
    color: #c9ccd1;
    margin-bottom: 1;
}

.verdict-bullish {
    background: #14f195;
    color: #14161a;
    text-style: bold;
    padding: 0 1;
}

.verdict-speculative {
    background: #f5a623;
    color: #14161a;
    text-style: bold;
    padding: 0 1;
}

.verdict-avoid {
    background: #ff4b4b;
    color: #f1f3f5;
    text-style: bold;
    padding: 0 1;
}

/* Trade Card */
.trade-card {
    background: #17211b;
    border: solid #14f195;
    padding: 1 2;
    margin: 1 0;
    height: auto;
}

.trade-header {
    text-style: bold;
    color: #14f195;
}

/* Positions Sidebar */
#positions-sidebar {
    width: 30%;
    height: 100%;
    background: #16191f;
    border-left: solid #2e3440;
    padding: 1 1;
}

.sidebar-title {
    text-style: bold;
    color: #9945ff;
    margin-bottom: 1;
}

.pos-card {
    background: #1e2229;
    border: round #2e3440;
    padding: 1 1;
    margin-bottom: 1;
    height: auto;
}

.pos-pnl-pos {
    color: #14f195;
    text-style: bold;
}

.pos-pnl-neg {
    color: #ff4b4b;
    text-style: bold;
}

/* Input Area */
#input-bar {
    dock: bottom;
    height: 6;
    background: #181b21;
    border-top: solid #2e3440;
    padding: 0 1;
}

#chips-row {
    height: 2;
    align-vertical: middle;
}

.chip-btn {
    height: 1;
    margin-right: 1;
    background: #242933;
    color: #c9ccd1;
    border: none;
}

.chip-btn:hover {
    background: #9945ff;
    color: #ffffff;
}

#input-row {
    height: 3;
    align-vertical: middle;
}

#prompt-input {
    width: 1fr;
    border: solid #9945ff;
    background: #14161a;
}

#prompt-input:focus {
    border: solid #14f195;
}

#send-button {
    width: 12;
    margin-left: 1;
    background: #9945ff;
    color: #ffffff;
    text-style: bold;
}

#send-button:hover {
    background: #14f195;
    color: #14161a;
}
